# Copy to /etc/codex-gateway/env (mode 0600) and fill in.
DATABASE_URL=postgres://codex:CHANGE_ME@127.0.0.1:5432/codex_gateway
GATEWAY_ADDR=127.0.0.1:8080
GATEWAY_PUBLIC_URL=https://codex.example.com
GATEWAY_ALLOWED_ORIGINS=https://codex.example.com
# Code sessions: clones and checkouts live here. The key encrypts GitHub tokens; generate with `openssl rand -hex 32`.
GATEWAY_CODE_DIR=/var/lib/codex-gateway/code
GATEWAY_GIT_BASE=https://github.com
GATEWAY_SECRET_KEY=CHANGE_ME_64_HEX
# Set to 0 in production; dev login is for local testing only.
GATEWAY_DEV_LOGIN=0
